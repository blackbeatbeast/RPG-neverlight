{
  "name": "project-neverlight",
  "private": true,
  "version": "0.1.0",
  "description": "Reproducible TypeScript monorepo foundation for Project Neverlight",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": "22.13.0",
    "pnpm": "9.15.4"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @neverlight/web --filter @neverlight/worker run dev",
    "build": "pnpm --filter @neverlight/* --recursive --if-present run build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"package.json\" \"pnpm-workspace.yaml\" \"tsconfig*.json\" \"*.{mjs,json,jsonc}\" \"apps/**/*.{ts,tsx,css,html,json,jsonc}\" \"packages/**/*.{ts,tsx,json}\" \"packages/db/migrations/README.md\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"package.json\" \"pnpm-workspace.yaml\" \"tsconfig*.json\" \"*.{mjs,json,jsonc}\" \"apps/**/*.{ts,tsx,css,html,json,jsonc}\" \"packages/**/*.{ts,tsx,json}\" \"packages/db/migrations/README.md\" \".github/workflows/*.yml\"",
    "typecheck": "pnpm --filter @neverlight/* --recursive --if-present run typecheck",
    "test": "pnpm validate:blueprint && pnpm --filter @neverlight/* --recursive --if-present run test",
    "test:e2e": "playwright test --config=apps/web/playwright.config.ts",
    "combat:replay": "pnpm --filter @neverlight/game-core run build && node scripts/combat-replay.mjs",
    "combat:simulate": "pnpm --filter @neverlight/game-core run build && node scripts/combat-simulate.mjs",
    "economy:simulate": "pnpm --filter @neverlight/game-core run build && node scripts/economy-simulate.mjs",
    "ledger:reconcile": "node scripts/ledger-reconcile.mjs",
    "validate:blueprint": "node scripts/validate-blueprint.mjs",
    "content:validate": "pnpm --filter @neverlight/content-schema run build && node scripts/validate-content.mjs content/first-region/bundle.json",
    "content:similarity-review": "node scripts/content-similarity-review.mjs",
    "db:migrate:local": "pnpm --filter @neverlight/worker run db:migrate:local"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "@playwright/test": "1.60.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
